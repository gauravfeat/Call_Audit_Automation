# ==============================================================================
# Call Audit Automation - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file or real client API keys to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True

# Google Gemini API Key (Required for Stage 2 KPI Validation, Stage 3 Email, and Stage 4 Summarization)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (Required for pyannote.audio speaker diarization models)
# Obtain from: https://huggingface.co/settings/tokens
# Also accept user conditions at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Faster-Whisper Speech-to-Text Configuration
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
# Inference device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute precision: int8 (CPU default), float16, float32
WHISPER_COMPUTE_TYPE=int8
# Decoding beam search width
WHISPER_BEAM_SIZE=5
# Silero VAD voice activity filter (reduces hallucinations during silence)
WHISPER_VAD_FILTER=true
# Extract word-level start/end timestamps
WHISPER_WORD_TIMESTAMPS=true


# Speech-to-Text Provider (sarvam, whisper, or whisper_api)
STT_PROVIDER=whisper_api

# Remote Whisper Large-v3 API Configuration
WHISPER_API_BASE_URL=http://122.170.2.205:7091
WHISPER_MODEL=openai/whisper-large-v3
WHISPER_TIMEOUT=600
WHISPER_RESPONSE_FORMAT=verbose_json
WHISPER_TEMPERATURE=0.0

# pyannote Speaker Diarization Configuration
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cpu
